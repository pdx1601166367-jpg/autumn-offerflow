[Unit]
Description=OfferFlow multi-user server
After=network.target

[Service]
Type=simple
User=offerflow
WorkingDirectory=/opt/offerflow
Environment=PORT=8125
Environment=NODE_ENV=production
# 校招信息每日自动收集的数据源，替换为你的 JSON 地址后生效
# Environment=RESOURCES_FEED_URL=https://example.com/campus-feed.json
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
