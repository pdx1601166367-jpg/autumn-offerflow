# 复制为 server/.env.local 并填写后生效（.env.local 已加入 .gitignore）
PORT=8125
AI_API_KEY=ark-你的豆包Key
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=ep-m-20260607002345-lbn6s

# 校招数据源（方案 A：JSON Feed，每日 09:00 自动抓取）
RESOURCES_FEED_URL=

# 白名单抓取器（方案 B）：多个 URL 用逗号分隔
WHITELIST_URLS=

# AI 配额（按 10 人规模预估）
AI_DAILY_LIMIT_PER_USER=60
AI_GUEST_DAILY=10
